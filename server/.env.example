# Server Environment Variables (Template)

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5433/noida_startup_atlas?schema=public"

# JWT secret (Required in production: use a 64+ char random string)
JWT_SECRET="YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server port
PORT=4000

# CORS origin (Frontend application URL)
CORS_ORIGIN="http://localhost:3000"

# Admin seed credentials (Explicit environment configuration required)
ADMIN_EMAIL="admin@noidaatlas.dev"
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"

# Node environment (development | test | production)
NODE_ENV="development"
